// prisma/schema.prisma

// This block generates the Prisma Client (your typesafe database client, default location)
generator client {
  provider = "prisma-client-js"
}

// Datasource — two URLs are required because Supabase exposes two endpoints:
//
//   DATABASE_URL  → transaction-mode pooler (port 6543, pgbouncer=true)
//     Used at runtime by the Next.js app. Connections are released back to the
//     pool the moment a query finishes, so many API routes can share a small
//     number of real DB connections without hitting Supabase’s 15-connection
//     session-mode ceiling.  Prepared statements are disabled (pgbouncer=true)
//     because PgBouncer in transaction mode does not support them.
//
//   DIRECT_URL    → direct Postgres connection (port 5432, no pooler)
//     Used only by Prisma CLI commands (prisma migrate, prisma db push,
//     prisma studio).  These commands need a persistent session — something
//     transaction-mode pooling cannot provide — so they bypass the pooler
//     entirely and talk to Postgres directly.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Main user table.
// NextAuth requires `id`, `email`, `name`, `image`, etc.
// We added `password` so you can later support credentials-based login.
// Relations: a user can have multiple accounts (e.g., Google, GitHub) and sessions.
model User {
  id            String   @id @default(cuid())
  // Standard NextAuth fields — required by PrismaAdapter for OAuth providers.
  name          String?
  image         String?
  firstName     String?
  lastName      String?
  username      String?  @unique
  email         String   @unique
  password      String?
  role          String   @default("user")
  emailVerified DateTime?
  verified      Boolean  @default(false)
  country       String?
  sex           String?
  dob           DateTime? @db.Date
  address       String?
  phoneNumber   String?

  // 🔗  Relations
  accounts      Account[]
  sessions      Session[]
  // A user can own multiple cards and binders, make offers, send messages, and participate in conversations.
  cards         Card[]
  binders       Binder[]
  offers        Offer[]          @relation("UserOffers")
  receivedOffers Offer[]         @relation("OffersReceived")
  sellerOrders  Order[] @relation("SellerOrders")
  buyerOrders   Order[] @relation("BuyerOrders")
  reservedCards Card[] @relation("CardReservations")
  sellerTransactions CardTransaction[] @relation("SellerTransactions")
  buyerTransactions  CardTransaction[] @relation("BuyerTransactions")
  watchlist     CardWatchlist[]
  cart          Cart?
  notifications Notification[]
  auctions           Auction[]  @relation("SellerAuctions")
  bids               Bid[]      @relation("UserBids")
  highestBidAuctions Auction[]  @relation("AuctionHighestBidder")
}

// Stores provider account details (e.g. Google, GitHub, etc.)
// Links back to User via userId
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Stores active sessions
// Each login creates a session with an expiry time
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  // Relation back to User
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// For email login flows (magic links, passwordless login, etc.)
// Stores one-time-use tokens
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

//////////////////////////////////////////////////////////////
// 🧩 Custom Models for Pokémon Marketplace & Inventory System
//////////////////////////////////////////////////////////////

// 🗂️ Binder — represents a user's collection folder or grouping of cards
model Binder {
  id        String   @id @default(uuid())
  name      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Relation: A binder contains multiple cards
  cards     Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🃏 Card — represents a single Pokémon card in a user's collection
model Card {
  id           String     @id @default(uuid())
  title        String
  price        Int?
  condition    String
  description  String?
  imageUrls    String[]   // URLs to Supabase Storage images
  forSale      Boolean    @default(false)

  // Reservation fields — used by the Buy Now Stripe Checkout flow to prevent
  // double-selling while the buyer is on Stripe's hosted payment page.
  // When a buyer starts checkout, the card is locked for a short window
  // (reservedUntil). On payment success the lock is cleared and ownership transfers.
  reservedBy                User?     @relation("CardReservations", fields: [reservedById], references: [id], onDelete: SetNull)
  reservedById              String?
  reservedUntil             DateTime?
  // Multiple cards can share the same session ID (cart checkout).
  reservedCheckoutSessionId String?

  // Optional enrichment fields (future-proof)
  tcgPlayerId  String
  language     String
  cardNumber   String?
  setName      String?
  rarity       String?

  // Relations
  binder       Binder?    @relation(fields: [binderId], references: [id], onDelete: SetNull)
  binderId     String?
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId      String
  offers       Offer[]
  transactions CardTransaction[]
  orders       Order[]
  watchlist    CardWatchlist[]
  cartItems    CartItem[]
  // Auction listings for this card (multiple allowed over time — one active at a time,
  // enforced at the application layer via Card.inAuction).
  inAuction    Boolean  @default(false)
  auctions     Auction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId])
  @@index([forSale])
}

model Order {
  id                String   @id @default(uuid())
  card              Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId             String

  seller             User     @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId           String
  buyer              User     @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId            String

  amount             Int      // store cents
  currency           String   @default("sgd")
  status             String   @default("PENDING") // PENDING | PAID | EXPIRED | CANCELED | REFUNDED

  // Multiple orders can share the same session ID (cart checkout).
  stripeCheckoutSessionId String?
  // Multiple orders in a cart share one payment intent; uniqueness enforced by Stripe itself.
  stripePaymentIntentId   String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  transactions       CardTransaction[]
  offer              Offer?

  @@index([stripeCheckoutSessionId])
  @@index([buyerId])
  @@index([sellerId])
}


// 💸 Offer — represents an offer made by a buyer on a card
model Offer {
  id          String    @id @default(uuid())
  price       Int?
  message     String?
  // Lifecycle: pending → accepted → paid  (happy path)
  //            pending → rejected         (seller declines)
  //            pending → expired          (no seller response within 24h; PI cancelled by cron)
  status      String    @default("pending")

  // Set when the card changes ownership (sold). New owner won't see archived offers,
  // but the historical record is preserved for buyers and admins.
  archivedAt  DateTime?

  // Stripe PaymentIntent ID for the authorised-but-not-captured charge.
  // Created when the buyer submits the offer form (capture_method: manual).
  // Captured on accept, cancelled on reject/expiry.
  paymentIntentId String?

  // When this pending offer expires (24h from creation).
  // After this point the cron job will cancel the PI and mark status → "expired".
  expiresAt   DateTime?

  // Relations
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId      String
  buyer       User      @relation("UserOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId     String
  // Snapshot of who the seller was at offer-creation time.
  // card.ownerId changes when the card is transferred, so we can't rely on it
  // to look up a seller's offer history after an accepted sale.
  seller      User      @relation("OffersReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId    String

  // Linked to an Order when the accepted offer is paid
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     String?   @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([cardId])
  @@index([buyerId])
  @@index([sellerId])
}

// 🌟 Admin-curated best sellers (by card type, not individual listing)
model BestSeller {
  id          String   @id @default(uuid())
  tcgPlayerId String   @unique // maps to Card.tcgPlayerId
  position    Int      @unique // display order 1–5
  createdAt   DateTime @default(now())
}

// 🔖 CardWatchlist — tracks which users have watchlisted which cards
model CardWatchlist {
  id        String   @id @default(uuid())
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([cardId, userId])
}

// 🛒 Cart — one persistent cart per user; created lazily on first add
model Cart {
  id        String     @id @default(uuid())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// 🛒 CartItem — a single card added to a user's cart
model CartItem {
  id        String   @id @default(uuid())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  // Whether this item is checked for checkout (user can uncheck individual items)
  selected  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([cartId, cardId])
}

// 🔔 Notification — in-app + email alerts for offer and sale events
model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Notification category — drives the icon and email copy.
  // Values: "offer_received" | "offer_accepted" | "offer_rejected" | "card_sold"
  type      String
  title     String
  body      String

  // Optional IDs for deep-linking into the relevant page.
  // Stored as plain strings (no FK) so the notification survives if the
  // linked record is later deleted.
  offerId   String?
  cardId    String?
  orderId   String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model CardTransaction {
  id            String @id @default(uuid())

  order         Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String

  card          Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId        String

  seller        User   @relation("SellerTransactions", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId      String

  buyer         User   @relation("BuyerTransactions", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId       String

  amount        Int
  currency      String
  // One Stripe event can cover multiple orders (cart checkout).
  stripeEventId String
  tcgPlayerId   String?

  createdAt     DateTime @default(now())

  // Composite: one stripe event may produce multiple transactions (one per order in cart checkout).
  @@unique([stripeEventId, orderId])
  @@index([buyerId])
  @@index([sellerId])
}

// 🔨 Auction — a timed listing where buyers compete with binding bids.
//
// Lifecycle:
//   active → sold                  (a bid hits RP/BO, or cron auto-settles when endsAt passes with bid >= RP)
//   active → pending_seller_decision  (endsAt passed, bid exists but below RP — seller gets 1 day)
//   active → expired               (endsAt passed, no bids placed)
//   pending_seller_decision → sold    (seller accepts within the deadline)
//   pending_seller_decision → expired (seller declines or deadline passes)
//
// One active auction per card is enforced at the application layer (Card.inAuction flag).
// Historical auction rows are kept for audit/display after the card is sold.
model Auction {
  id        String @id @default(uuid())
  card      Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String
  seller    User   @relation("SellerAuctions", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerId  String

  startingBid  Int   // minimum first bid (cents)
  reservePrice Int?  // auto-accept floor checked at endsAt: if final bid >= RP the cron settles without seller action; does NOT end the auction early during bidding
  buyOutPrice  Int?  // instant-purchase price: bid >= BO ends the auction immediately during bidding

  currentBid      Int?    // current highest bid amount (cents); null = no bids yet
  highestBidder   User?   @relation("AuctionHighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)
  highestBidderId String?

  // active | pending_seller_decision | sold | expired
  status String @default("active")

  endsAt                 DateTime  // when the auction closes (1–6 days from creation)
  sellerDecisionDeadline DateTime? // set when → pending_seller_decision (+24h); null otherwise

  // Optimistic lock counter: every bid increments this.
  // Concurrent bid requests use updateMany WHERE version = snapshot to ensure
  // only one bid wins the write; the loser gets a 409 and retries.
  version Int @default(0)

  bids Bid[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endsAt])
}

// 💵 Bid — a single binding bid placed by a buyer in an auction.
//
// Each bid holds a Stripe PaymentIntent (capture_method: "manual").
// Funds are authorised (held) on the buyer's card but not charged until
// the auction settles.
//
// Status values:
//   active    — current highest bid; PI hold is live
//   won       — this bid won the auction; PI was captured
//   cancelled — outbid or auction ended without a win; PI was cancelled
model Bid {
  id        String  @id @default(uuid())
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  auctionId String
  bidder    User    @relation("UserBids", fields: [bidderId], references: [id], onDelete: Restrict)
  bidderId  String

  amount          Int    // bid amount in cents
  paymentIntentId String // Stripe PI with capture_method: "manual"

  // active | won | cancelled
  status String @default("active")

  createdAt DateTime @default(now())

  @@index([auctionId, status])
  @@index([bidderId])
}

